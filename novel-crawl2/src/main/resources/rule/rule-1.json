    "coverUrl": "div.book_info > img",
    "status": "div.finish > h2"
  },
  "toc": {
    "item": "#dir > dd > a",
    "offset": 0
  },
  "chapter": {
    "useBrowser": true,
    "title": "h2.h2",
    "content": "#content",
    "paragraphTagClosed": true,
    "paragraphTag": "div",
    "pagination": false,
    "filterTxt": "\\(本章完\\)|和.{0,5}图.{0,5}书",
